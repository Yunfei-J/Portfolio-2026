---
import CaseStudyBackLink from "./case-study/CaseStudyBackLink.astro";

export type TocItem = {
  id: string;
  title: string;
};

type Props = {
  items: TocItem[];
};

const { items } = Astro.props;
---

<nav
  class="case-toc is-expanded"
  data-case-toc
  aria-label="Table of contents"
>
  <div class="case-toc-actions">
    <CaseStudyBackLink class="case-toc-back" />
    <button
      type="button"
      class="case-study-back case-toc-top"
      aria-label="Back to top"
    >
      <svg
        width="48"
        height="48"
        viewBox="0 0 64 64"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <rect width="64" height="64" rx="32" fill="black" fill-opacity="0.05"></rect>
        <path
          d="M24.832 35.096L21.856 33.464L31.168 24.792L33.28 27.032L24.832 35.096ZM41.824 35H24.224V31.896H41.824V35ZM31.264 42.072L21.856 33.464L24.8 31.8L33.344 39.8L31.264 42.072Z"
          fill="#787878"></path>
      </svg>
    </button>
  </div>
  <div class="case-toc-inner">
    <div class="case-toc-rail" aria-hidden="true">
      <div class="case-toc-rail-track"></div>
      <div class="case-toc-rail-indicator" data-toc-indicator></div>
    </div>

    <ol class="case-toc-list">
    {
      items.map((item, index) => (
        <li class="case-toc-item" data-toc-item>
          <a
            class="case-toc-link"
            data-toc-link
            data-index={index}
            href={`#${item.id}`}
          >
            <span class="case-toc-num">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="case-toc-label">{item.title}</span>
          </a>
        </li>
      ))
    }
    </ol>
  </div>
</nav>

<script>
  function initCaseToc() {
    var toc = document.querySelector("[data-case-toc]");
    if (!toc) return;

    if (toc._tocAbort) toc._tocAbort.abort();
    var ac = new AbortController();
    toc._tocAbort = ac;
    var signal = ac.signal;

    var links = Array.from(toc.querySelectorAll("[data-toc-link]"));
    var indicator = toc.querySelector("[data-toc-indicator]");
    var sections = links
      .map(function (link) {
        var id = link.getAttribute("href")?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean);

    if (!sections.length) return;

    var alwaysExpanded = true;
    var activeIndex = 0;
    var lockedIndex = -1;
    var scrollTicking = false;
    var markerRatio = 0.25;
    var lastScrollY = window.scrollY;
    var upTravel = 0;
    var actionLinks = toc.querySelectorAll(".case-toc-actions a, .case-toc-actions button");
    var topButton = toc.querySelector(".case-toc-top");
    var SHOW_BACK_AFTER = 400;
    var HIDE_BACK_NEAR_TOP = 80;

    function setActive(index) {
      if (index < 0 || index >= links.length || index === activeIndex) return;
      activeIndex = index;
      links.forEach(function (link, i) {
        link.classList.toggle("is-active", i === index);
      });
      moveIndicator(index);
    }

    function syncRailTrack() {
      var rail = toc.querySelector(".case-toc-rail");
      var items = toc.querySelectorAll("[data-toc-item]");
      if (!rail || !indicator || !items.length) return;
      var indicatorH = indicator.offsetHeight;
      var first = items[0];
      var last = items[items.length - 1];
      var topInset = Math.max(0, (first.offsetHeight - indicatorH) / 2);
      var bottomInset = Math.max(0, (last.offsetHeight - indicatorH) / 2);
      rail.style.setProperty("--toc-track-inset-top", topInset + "px");
      rail.style.setProperty("--toc-track-inset-bottom", bottomInset + "px");
    }

    function moveIndicator(index) {
      if (!indicator) return;
      var link = links[index];
      var item = link.closest("[data-toc-item]");
      if (!item) return;
      var rail = toc.querySelector(".case-toc-rail");
      if (!rail) return;
      var itemRect = item.getBoundingClientRect();
      var railRect = rail.getBoundingClientRect();
      var offset =
        itemRect.top -
        railRect.top +
        (itemRect.height - indicator.offsetHeight) / 2;
      indicator.style.transform = "translateY(" + offset + "px)";
    }

    function getActiveIndexFromScroll() {
      var markerY = window.innerHeight * markerRatio;
      var next = 0;

      for (var i = 0; i < sections.length; i++) {
        if (sections[i].getBoundingClientRect().top <= markerY) {
          next = i;
        }
      }

      return next;
    }

    function setBackVisible(visible) {
      toc.classList.toggle("is-back-visible", visible);
      actionLinks.forEach(function (el) {
        el.setAttribute("aria-hidden", visible ? "false" : "true");
        if (visible) el.removeAttribute("tabindex");
        else el.setAttribute("tabindex", "-1");
      });
    }

    function syncBackFromScroll() {
      var y = window.scrollY;
      var delta = y - lastScrollY;
      lastScrollY = y;

      if (y <= HIDE_BACK_NEAR_TOP) {
        upTravel = 0;
        setBackVisible(false);
        return;
      }

      if (delta < 0) {
        upTravel += -delta;
        if (upTravel >= SHOW_BACK_AFTER) setBackVisible(true);
        return;
      }

      if (delta > 0) {
        upTravel = 0;
        setBackVisible(false);
      }
    }

    function syncActiveFromScroll() {
      scrollTicking = false;
      syncBackFromScroll();
      if (lockedIndex >= 0) return;
      setActive(getActiveIndexFromScroll());
    }

    function queueScrollSync() {
      if (scrollTicking) return;
      scrollTicking = true;
      requestAnimationFrame(syncActiveFromScroll);
    }

    function releaseScrollLock() {
      lockedIndex = -1;
      syncActiveFromScroll();
    }

    function lockScrollTo(index) {
      lockedIndex = index;
      setActive(index);

      if ("onscrollend" in window) {
        var onScrollEnd = function () {
          window.removeEventListener("scrollend", onScrollEnd);
          releaseScrollLock();
        };
        window.addEventListener("scrollend", onScrollEnd, { once: true, signal: signal });
        return;
      }

      var lastY = window.scrollY;
      var stableFrames = 0;

      function waitForScrollEnd() {
        if (signal.aborted) return;

        if (window.scrollY === lastY) {
          stableFrames += 1;
          if (stableFrames >= 3) {
            releaseScrollLock();
            return;
          }
        } else {
          stableFrames = 0;
          lastY = window.scrollY;
        }

        requestAnimationFrame(waitForScrollEnd);
      }

      requestAnimationFrame(waitForScrollEnd);
    }

    if (topButton) {
      topButton.addEventListener(
        "click",
        function () {
          window.scrollTo({ top: 0, behavior: "smooth" });
        },
        { signal: signal },
      );
    }

    links.forEach(function (link, index) {
      link.addEventListener(
        "click",
        function (e) {
          e.preventDefault();
          var id = link.getAttribute("href")?.slice(1);
          var target = id ? document.getElementById(id) : null;
          if (!target) return;
          lockScrollTo(index);
          target.scrollIntoView({ behavior: "smooth", block: "start" });
          if (
            !alwaysExpanded &&
            window.matchMedia("(max-width: 900px)").matches
          ) {
            toc.classList.remove("is-expanded");
          }
        },
        { signal: signal },
      );
    });

    window.addEventListener("scroll", queueScrollSync, { passive: true, signal: signal });

    if (!alwaysExpanded) {
      toc.addEventListener(
        "mouseenter",
        function () {
          toc.classList.add("is-expanded");
          requestAnimationFrame(function () {
            moveIndicator(activeIndex);
          });
        },
        { signal: signal },
      );

      toc.addEventListener(
        "mouseleave",
        function () {
          if (!window.matchMedia("(max-width: 900px)").matches) {
            toc.classList.remove("is-expanded");
          }
        },
        { signal: signal },
      );

      if (window.matchMedia("(max-width: 900px)").matches) {
        toc.addEventListener(
          "click",
          function () {
            toc.classList.toggle("is-expanded");
            requestAnimationFrame(function () {
              moveIndicator(activeIndex);
            });
          },
          { signal: signal },
        );
      }
    }

    window.addEventListener(
      "resize",
      function () {
        syncRailTrack();
        moveIndicator(activeIndex);
        queueScrollSync();
      },
      { signal: signal },
    );

    var list = toc.querySelector(".case-toc-list");
    if (list && "ResizeObserver" in window) {
      var listResize = new ResizeObserver(function () {
        syncRailTrack();
        moveIndicator(activeIndex);
      });
      listResize.observe(list);
      signal.addEventListener("abort", function () {
        listResize.disconnect();
      });
    }

    activeIndex = -1;
    setBackVisible(false);
    setActive(getActiveIndexFromScroll());
    requestAnimationFrame(function () {
      syncRailTrack();
      moveIndicator(activeIndex);
    });
  }

  initCaseToc();
  document.addEventListener("astro:page-load", initCaseToc);
</script>
