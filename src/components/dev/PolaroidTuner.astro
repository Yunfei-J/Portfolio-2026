---
/**
 * Dev-only control panel for the hero polaroid holo card.
 * Edits the --polaroid-* tokens live; "Copy" gives a block to paste into tokens.css.
 */
type Control =
  | { name: string; label: string; type: "range"; min: number; max: number; step: number; unit?: string }
  | { name: string; label: string; type: "color" }
  | { name: string; label: string; type: "select"; options: string[] };

const groups: { title: string; controls: Control[] }[] = [
  {
    title: "Tilt",
    controls: [
      { name: "--polaroid-tilt-max", label: "Tilt sensitivity (°)", type: "range", min: 0, max: 40, step: 1 },
      { name: "--polaroid-perspective", label: "Perspective", type: "range", min: 400, max: 3000, step: 50, unit: "px" },
      { name: "--polaroid-spring-stiffness", label: "Follow speed", type: "range", min: 0.01, max: 0.3, step: 0.005 },
      { name: "--polaroid-spring-damping", label: "Follow damping", type: "range", min: 0.05, max: 0.6, step: 0.01 },
      { name: "--polaroid-return-stiffness", label: "Return speed", type: "range", min: 0.005, max: 0.2, step: 0.005 },
      { name: "--polaroid-return-damping", label: "Return damping", type: "range", min: 0.02, max: 0.5, step: 0.01 },
    ],
  },
  {
    title: "Flip",
    controls: [
      { name: "--polaroid-flip-ms", label: "Spin (ms)", type: "range", min: 200, max: 3000, step: 50 },
      { name: "--polaroid-flip-hold", label: "Slow on back (ms)", type: "range", min: 0, max: 6000, step: 100 },
      { name: "--polaroid-flip-turns", label: "Turns", type: "range", min: 0, max: 3, step: 1 },
    ],
  },
  {
    title: "Foil shine",
    controls: [
      { name: "--polaroid-idle-shine", label: "Shine at rest", type: "range", min: 0, max: 1, step: 0.05 },
      { name: "--polaroid-foil-opacity", label: "Intensity", type: "range", min: 0, max: 1, step: 0.05 },
      { name: "--polaroid-foil-brightness", label: "Brightness", type: "range", min: 0.2, max: 2, step: 0.05 },
      { name: "--polaroid-foil-contrast", label: "Contrast", type: "range", min: 0.5, max: 3, step: 0.05 },
      { name: "--polaroid-foil-saturate", label: "Saturation", type: "range", min: 0, max: 4, step: 0.1 },
      {
        name: "--polaroid-foil-blend",
        label: "Blend mode",
        type: "select",
        options: ["hard-light", "normal", "screen", "color", "hue", "overlay", "soft-light", "multiply", "color-dodge", "luminosity", "plus-lighter"],
      },
      { name: "--polaroid-foil-angle", label: "Band angle", type: "range", min: 0, max: 180, step: 1, unit: "deg" },
      { name: "--polaroid-foil-band", label: "Band width", type: "range", min: 1, max: 20, step: 0.5, unit: "%" },
      { name: "--polaroid-foil-travel", label: "Shine travel", type: "range", min: 0, max: 3, step: 0.1 },
    ],
  },
  {
    title: "Shine colours",
    controls: [
      { name: "--polaroid-foil-stripe", label: "Stripe", type: "color" as const },
      ...[1, 2, 3, 4, 5, 6].map((n) => ({
        name: `--polaroid-foil-${n}`,
        label: `Colour ${n}`,
        type: "color" as const,
      })),
    ],
  },
  {
    title: "Glare",
    controls: [
      { name: "--polaroid-glare-opacity", label: "Intensity", type: "range", min: 0, max: 1, step: 0.05 },
      { name: "--polaroid-glare-size", label: "Highlight size", type: "range", min: 0.2, max: 4, step: 0.1 },
      { name: "--polaroid-glare-shade", label: "Edge darkening", type: "range", min: 0, max: 1, step: 0.05 },
    ],
  },
  {
    title: "Frame",
    controls: [{ name: "--polaroid-frame-hover", label: "Hovered colour", type: "color" }],
  },
];
---

<details class="polaroid-tuner" open data-polaroid-tuner>
  <summary>Polaroid tuner</summary>

  <div class="polaroid-tuner-actions">
    <button type="button" data-tuner-flip>Flip</button>
    <label class="polaroid-tuner-toggle">
      <input type="checkbox" data-tuner-hold />
      Hold shine on
    </label>
  </div>

  {
    groups.map((group) => (
      <fieldset>
        <legend>{group.title}</legend>
        {group.controls.map((control) => (
          <label class="polaroid-tuner-row">
            <span class="polaroid-tuner-label">
              {control.label}
              <output data-tuner-output={control.name} />
            </span>
            {control.type === "range" && (
              <input
                type="range"
                min={control.min}
                max={control.max}
                step={control.step}
                data-tuner-var={control.name}
                data-tuner-unit={control.unit ?? ""}
              />
            )}
            {control.type === "color" && <input type="color" data-tuner-var={control.name} data-tuner-unit="" />}
            {control.type === "select" && (
              <select data-tuner-var={control.name} data-tuner-unit="">
                {control.options.map((option) => (
                  <option value={option}>{option}</option>
                ))}
              </select>
            )}
          </label>
        ))}
      </fieldset>
    ))
  }

  <div class="polaroid-tuner-actions">
    <button type="button" data-tuner-copy>Copy CSS</button>
    <button type="button" data-tuner-reset>Reset</button>
  </div>
</details>

<script>
  const STORAGE_KEY = "polaroid-tune";
  const root = document.documentElement;
  const panel = document.querySelector<HTMLElement>("[data-polaroid-tuner]");

  if (panel) {
    const inputs = Array.from(
      panel.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-tuner-var]"),
    );
    const holdToggle = panel.querySelector<HTMLInputElement>("[data-tuner-hold]");
    const saved: Record<string, string> = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "{}");
    if (saved["--color-polaroid-frame"]) {
      saved["--polaroid-frame-hover"] ??= saved["--color-polaroid-frame"];
      delete saved["--color-polaroid-frame"];
      root.style.removeProperty("--color-polaroid-frame");
      localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
    }

    const notify = () => document.dispatchEvent(new Event("polaroid:tune"));
    const current = (name: string) => getComputedStyle(root).getPropertyValue(name).trim();

    const applyHold = () => {
      if (holdToggle?.checked) root.style.setProperty("--polaroid-idle-shine", "1");
      else if (saved["--polaroid-idle-shine"]) root.style.setProperty("--polaroid-idle-shine", saved["--polaroid-idle-shine"]);
      else root.style.removeProperty("--polaroid-idle-shine");
    };

    const sync = () => {
      for (const input of inputs) {
        const name = input.dataset.tunerVar!;
        const unit = input.dataset.tunerUnit ?? "";
        const value = saved[name] ?? current(name);
        input.value = unit ? String(parseFloat(value)) : value;
        const output = panel.querySelector<HTMLOutputElement>(`[data-tuner-output="${name}"]`);
        if (output) output.textContent = input.type === "color" ? input.value : value;
      }
    };

    for (const [name, value] of Object.entries(saved)) root.style.setProperty(name, value);
    sync();
    notify();

    for (const input of inputs) {
      input.addEventListener("input", () => {
        const name = input.dataset.tunerVar!;
        const value = input.value + (input.dataset.tunerUnit ?? "");
        saved[name] = value;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
        root.style.setProperty(name, value);
        if (name === "--polaroid-idle-shine") applyHold();
        const output = panel.querySelector<HTMLOutputElement>(`[data-tuner-output="${name}"]`);
        if (output) output.textContent = value;
        notify();
      });
    }

    holdToggle?.addEventListener("change", () => {
      applyHold();
      notify();
    });

    panel.querySelector("[data-tuner-flip]")?.addEventListener("click", () => {
      document.dispatchEvent(new Event("polaroid:flip"));
    });

    panel.querySelector<HTMLButtonElement>("[data-tuner-copy]")?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const lines = inputs.map((input) => {
        const name = input.dataset.tunerVar!;
        return `  ${name}: ${saved[name] ?? current(name)};`;
      });
      await navigator.clipboard.writeText(lines.join("\n"));
      button.textContent = "Copied!";
      setTimeout(() => (button.textContent = "Copy CSS"), 1200);
    });

    panel.querySelector("[data-tuner-reset]")?.addEventListener("click", () => {
      for (const name of Object.keys(saved)) {
        root.style.removeProperty(name);
        delete saved[name];
      }
      localStorage.removeItem(STORAGE_KEY);
      applyHold();
      sync();
      notify();
    });
  }
</script>

<style>
  .polaroid-tuner {
    background: rgb(20 20 18 / 92%);
    border-radius: 12px;
    box-shadow: 0 8px 30px rgb(0 0 0 / 35%);
    color: #f2f2ee;
    font: 12px/1.3 system-ui, sans-serif;
    max-height: calc(100vh - 32px);
    overflow: auto;
    padding: 10px 14px 14px;
    position: fixed;
    right: 16px;
    top: 16px;
    width: 290px;
    z-index: 10000;
  }

  .polaroid-tuner:not([open]) {
    width: auto;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 4px 0;
  }

  fieldset {
    border: 0;
    border-top: 1px solid rgb(255 255 255 / 12%);
    margin: 10px 0 0;
    padding: 8px 0 0;
  }

  legend {
    color: #dfea81;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0 6px 0 0;
    text-transform: uppercase;
  }

  .polaroid-tuner-row {
    display: grid;
    gap: 4px;
    margin-top: 8px;
  }

  .polaroid-tuner-label {
    display: flex;
    justify-content: space-between;
  }

  output {
    color: rgb(255 255 255 / 60%);
    font-variant-numeric: tabular-nums;
  }

  input[type="range"] {
    accent-color: #dfea81;
    width: 100%;
  }

  input[type="color"] {
    background: none;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 6px;
    height: 26px;
    padding: 2px;
    width: 100%;
  }

  select {
    background: #2a2a26;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 6px;
    color: inherit;
    padding: 4px 6px;
  }

  .polaroid-tuner-actions {
    align-items: center;
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .polaroid-tuner-actions button {
    background: #dfea81;
    border: 0;
    border-radius: 6px;
    color: #1a1a16;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    padding: 6px 12px;
  }

  .polaroid-tuner-toggle {
    align-items: center;
    display: flex;
    gap: 6px;
  }
</style>
