---
/**
 * PolaroidCard — lime-green Polaroid frame
 *
 * Desktop: 667 × 791 px SVG mask + HTML footer
 * Mobile:  482 × 678 px SVG mask + HTML footer (straightened mobile proportions)
 *
 * Lens cutouts are genuinely transparent via SVG masks.
 */
interface Props {
  caption?: string;
  class?: string;
}

const { caption = "That you are looking for", class: className } = Astro.props;

const DESKTOP = {
  w: 667,
  h: 791,
  padSide: 48,
  padTop: 48,
  footerH: 164,
};

const MOBILE = {
  w: 482,
  h: 678,
  padSide: 35,
  padTop: 35,
  footerH: 141,
};

const desktopLens = {
  x: DESKTOP.padSide,
  y: DESKTOP.padTop,
  w: DESKTOP.w - DESKTOP.padSide * 2,
  h: DESKTOP.h - DESKTOP.padTop - DESKTOP.footerH,
};

const mobileLens = {
  x: MOBILE.padSide,
  y: MOBILE.padTop,
  w: MOBILE.w - MOBILE.padSide * 2,
  h: MOBILE.h - MOBILE.padTop - MOBILE.footerH,
};
---

<div class:list={["polaroid-wrap", className]} data-polaroid>
 <div class="polaroid-tilt" data-polaroid-tilt>

  <!-- ── Desktop frame ─────────────────────────────────────────────── -->
  <div class="polaroid-frame polaroid-frame--desktop">
    <svg
      class="polaroid-svg"
      viewBox={`0 0 ${DESKTOP.w} ${DESKTOP.h}`}
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <filter
          id="polaroid-texture-desktop"
          x="-8"
          y="-8"
          width={DESKTOP.w + 16}
          height={DESKTOP.h + 16}
          filterUnits="userSpaceOnUse"
          color-interpolation-filters="sRGB"
        >
          <feFlood flood-opacity="0" result="BackgroundImageFix"></feFlood>
          <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"></feBlend>
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.25 0.25"
            numOctaves="3"
            seed="6451"
            result="noise"></feTurbulence>
          <feDisplacementMap
            in="shape"
            in2="noise"
            scale="8"
            xChannelSelector="R"
            yChannelSelector="G"
            result="displacedImage"></feDisplacementMap>
          <feMerge>
            <feMergeNode in="displacedImage"></feMergeNode>
          </feMerge>
        </filter>
        <mask id="frame-mask-desktop">
          <rect width={DESKTOP.w} height={DESKTOP.h} fill="white" />
          <rect
            x={desktopLens.x}
            y={desktopLens.y}
            width={desktopLens.w}
            height={desktopLens.h}
            rx="4"
            fill="black"
          />
        </mask>
      </defs>
      <g filter="url(#polaroid-texture-desktop)">
        <rect
          width={DESKTOP.w}
          height={DESKTOP.h}
          fill="var(--color-polaroid-frame)"
          mask="url(#frame-mask-desktop)"
        />
      </g>
    </svg>

    <footer class="polaroid-footer polaroid-footer--desktop">
      <span class="polaroid-caption">{caption}</span>
      <div class="polaroid-actions">
        <button
          type="button"
          class="polaroid-like"
          aria-label="Like"
          aria-pressed="false"
          data-polaroid-like
        >
          <svg class="polaroid-like-outline" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06
                     a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78
                     1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="polaroid-like-anim" aria-hidden="true" data-like-anim></span>
        </button>
        <svg viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0
                   2-1.7l1.38-9a2 2 0 0 0-2-2.3H14z"/>
          <path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/>
        </svg>
        <svg viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="17 1 21 5 17 9"/>
          <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
          <polyline points="7 23 3 19 7 15"/>
          <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
        </svg>
      </div>
    </footer>
    <div class="polaroid-holo" aria-hidden="true">
      <span class="polaroid-holo-foil"></span>
      <span class="polaroid-holo-glare"></span>
    </div>
  </div>

  <!-- ── Mobile frame (482 × 678) ─────────────────────────────────── -->
  <div class="polaroid-frame polaroid-frame--mobile">
    <svg
      class="polaroid-svg"
      viewBox={`0 0 ${MOBILE.w} ${MOBILE.h}`}
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <filter
          id="polaroid-texture-mobile"
          x="-8"
          y="-8"
          width={MOBILE.w + 16}
          height={MOBILE.h + 16}
          filterUnits="userSpaceOnUse"
