---
/**
 * PolaroidCard — lime-green Polaroid frame
 *
 * Desktop: 667 × 791 px SVG mask + HTML footer
 * Mobile:  482 × 678 px SVG mask + HTML footer (straightened mobile proportions)
 *
 * Lens cutouts are genuinely transparent via SVG masks.
 */
interface Props {
  caption?: string;
  class?: string;
}

const { caption = "That you are looking for", class: className } = Astro.props;

const DESKTOP = {
  w: 667,
  h: 791,
  padSide: 48,
  padTop: 48,
  footerH: 164,
};

const MOBILE = {
  w: 482,
  h: 678,
  padSide: 35,
  padTop: 35,
  footerH: 141,
};

const desktopLens = {
  x: DESKTOP.padSide,
  y: DESKTOP.padTop,
  w: DESKTOP.w - DESKTOP.padSide * 2,
  h: DESKTOP.h - DESKTOP.padTop - DESKTOP.footerH,
};

const mobileLens = {
  x: MOBILE.padSide,
  y: MOBILE.padTop,
  w: MOBILE.w - MOBILE.padSide * 2,
  h: MOBILE.h - MOBILE.padTop - MOBILE.footerH,
};
---

<div class:list={["polaroid-wrap", className]}>

  <!-- ── Desktop frame ─────────────────────────────────────────────── -->
  <div class="polaroid-frame polaroid-frame--desktop">
    <svg
      class="polaroid-svg"
      viewBox={`0 0 ${DESKTOP.w} ${DESKTOP.h}`}
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <filter
          id="polaroid-texture-desktop"
          x="-8"
          y="-8"
          width={DESKTOP.w + 16}
          height={DESKTOP.h + 16}
          filterUnits="userSpaceOnUse"
          color-interpolation-filters="sRGB"
        >
          <feFlood flood-opacity="0" result="BackgroundImageFix"></feFlood>
          <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"></feBlend>
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.25 0.25"
            numOctaves="3"
            seed="6451"
            result="noise"></feTurbulence>
          <feDisplacementMap
            in="shape"
            in2="noise"
            scale="8"
            xChannelSelector="R"
            yChannelSelector="G"
            result="displacedImage"></feDisplacementMap>
          <feMerge>
            <feMergeNode in="displacedImage"></feMergeNode>
          </feMerge>
        </filter>
        <mask id="frame-mask-desktop">
          <rect width={DESKTOP.w} height={DESKTOP.h} fill="white" />
          <rect
            x={desktopLens.x}
            y={desktopLens.y}
            width={desktopLens.w}
            height={desktopLens.h}
            rx="4"
            fill="black"
          />
        </mask>
      </defs>
      <g filter="url(#polaroid-texture-desktop)">
        <rect
          width={DESKTOP.w}
          height={DESKTOP.h}
          fill="var(--color-polaroid-frame)"
          mask="url(#frame-mask-desktop)"
        />
      </g>
    </svg>

    <footer class="polaroid-footer polaroid-footer--desktop">
      <span class="polaroid-caption">{caption}</span>
      <div class="polaroid-actions">
        <button
          type="button"
          class="polaroid-like"
          aria-label="Like"
          aria-pressed="false"
          data-polaroid-like
        >
          <svg class="polaroid-like-outline" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06
                     a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78
                     1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="polaroid-like-anim" aria-hidden="true" data-like-anim></span>
        </button>
        <svg viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0
                   2-1.7l1.38-9a2 2 0 0 0-2-2.3H14z"/>
          <path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/>
        </svg>
        <svg viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="17 1 21 5 17 9"/>
          <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
          <polyline points="7 23 3 19 7 15"/>
          <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
        </svg>
      </div>
    </footer>
  </div>

  <!-- ── Mobile frame (482 × 678) ─────────────────────────────────── -->
  <div class="polaroid-frame polaroid-frame--mobile">
    <svg
      class="polaroid-svg"
      viewBox={`0 0 ${MOBILE.w} ${MOBILE.h}`}
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid meet"
    >
      <defs>
        <filter
          id="polaroid-texture-mobile"
          x="-8"
          y="-8"
          width={MOBILE.w + 16}
          height={MOBILE.h + 16}
          filterUnits="userSpaceOnUse"
          color-interpolation-filters="sRGB"
        >
          <feFlood flood-opacity="0" result="BackgroundImageFix"></feFlood>
          <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"></feBlend>
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.25 0.25"
            numOctaves="3"
            seed="6451"
            result="noise"></feTurbulence>
          <feDisplacementMap
            in="shape"
            in2="noise"
            scale="8"
            xChannelSelector="R"
            yChannelSelector="G"
            result="displacedImage"></feDisplacementMap>
          <feMerge>
            <feMergeNode in="displacedImage"></feMergeNode>
          </feMerge>
        </filter>
        <mask id="frame-mask-mobile">
          <rect width={MOBILE.w} height={MOBILE.h} fill="white" />
          <rect
            x={mobileLens.x}
            y={mobileLens.y}
            width={mobileLens.w}
            height={mobileLens.h}
            rx="4"
            fill="black"
          />
        </mask>
      </defs>
      <g filter="url(#polaroid-texture-mobile)">
        <rect
          width={MOBILE.w}
          height={MOBILE.h}
          fill="var(--color-polaroid-frame)"
          mask="url(#frame-mask-mobile)"
        />
      </g>
    </svg>

    <footer class="polaroid-footer polaroid-footer--mobile">
      <span class="polaroid-caption">{caption}</span>
      <div class="polaroid-actions">
        <button
          type="button"
          class="polaroid-like"
          aria-label="Like"
          aria-pressed="false"
          data-polaroid-like
        >
          <svg class="polaroid-like-outline" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06
                     a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78
                     1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="polaroid-like-anim" aria-hidden="true" data-like-anim></span>
        </button>
        <svg viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0
                   2-1.7l1.38-9a2 2 0 0 0-2-2.3H14z"/>
          <path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/>
        </svg>
        <svg viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="17 1 21 5 17 9"/>
          <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
          <polyline points="7 23 3 19 7 15"/>
          <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
        </svg>
      </div>
    </footer>
  </div>

</div>

<script>
  import type { AnimationItem } from "lottie-web";

  const HEART_SRC = "/assets/lottie/heart-fav.json";
  let lottiePromise: Promise<typeof import("lottie-web/build/player/lottie_light").default> | null = null;
  const loadLottie = () =>
    (lottiePromise ??= import("lottie-web/build/player/lottie_light").then((m) => m.default));

  function initPolaroidLikes() {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    document.querySelectorAll<HTMLButtonElement>("[data-polaroid-like]").forEach((button) => {
      if (button.dataset.likeReady) return;
      button.dataset.likeReady = "true";

      const container = button.querySelector<HTMLElement>("[data-like-anim]");
      if (!container) return;

      let anim: Promise<AnimationItem> | null = null;
      const getAnim = () =>
        (anim ??= loadLottie().then(
          (lottie) =>
            new Promise<AnimationItem>((resolve) => {
              const item = lottie.loadAnimation({
                container,
                renderer: "svg",
                loop: false,
                autoplay: false,
                path: HEART_SRC,
              });
              item.addEventListener("DOMLoaded", () => resolve(item));
            }),
        ));

      button.addEventListener("pointerenter", () => void getAnim(), { once: true });
      button.addEventListener("focus", () => void getAnim(), { once: true });

      button.addEventListener("click", async () => {
        const liked = button.getAttribute("aria-pressed") !== "true";
        button.setAttribute("aria-pressed", String(liked));
        const item = await getAnim();
        if (!liked) item.goToAndStop(0, true);
        else if (reducedMotion.matches) item.goToAndStop(item.totalFrames - 1, true);
        else item.goToAndPlay(0, true);
      });
    });
  }

  initPolaroidLikes();
  document.addEventListener("astro:page-load", initPolaroidLikes);
</script>

<style>
  .polaroid-wrap {
    flex-shrink: 0;
    height: var(--polaroid-height, 791px);
    position: relative;
    width: var(--polaroid-width, 667px);
  }

  /* --s = px per SVG unit of the letterboxed frame, so the HTML footer scales with the artwork. */
  .polaroid-frame {
    container-type: size;
    inset: 0;
    position: absolute;
  }

  .polaroid-frame--desktop {
    --frame-w: 667;
    --frame-h: 791;
  }

  .polaroid-frame--mobile {
    --frame-w: 482;
    --frame-h: 678;
  }

  .polaroid-footer {
    --s: min(100cqw / var(--frame-w), 100cqh / var(--frame-h));
    --frame-x: calc((100cqw - var(--frame-w) * var(--s)) / 2);
    --frame-y: calc((100cqh - var(--frame-h) * var(--s)) / 2);
  }

  .polaroid-frame--mobile {
    display: none;
  }

  .polaroid-svg {
    display: block;
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
  }

  .polaroid-footer {
    align-items: center;
    color: #111;
    display: flex;
    justify-content: space-between;
    letter-spacing: -0.01em;
    position: absolute;
  }

  .polaroid-footer--desktop {
    bottom: calc(var(--frame-y) + 40.7 * var(--s));
    font-size: calc(26.7 * var(--s));
    height: calc(144 * var(--s));
    left: var(--frame-x);
    padding: 0 calc(66.7 * var(--s));
    right: var(--frame-x);
  }

  .polaroid-footer--mobile {
    bottom: calc(var(--frame-y) + 70 * var(--s));
    font-size: calc(25 * var(--s));
    height: calc(116 * var(--s));
    left: calc(var(--frame-x) + 12.5 * var(--s));
    padding: 0 calc(45 * var(--s));
    right: var(--frame-x);
  }

  .polaroid-caption {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 300;
  }

  .polaroid-actions {
    align-items: center;
    display: flex;
    gap: calc(24 * var(--s));
  }

  .polaroid-footer--mobile .polaroid-actions {
    gap: calc(17.5 * var(--s));
  }

  .polaroid-actions svg {
    cursor: pointer;
    flex-shrink: 0;
    height: calc(37.4 * var(--s));
    opacity: 0.75;
    transition: opacity 200ms ease;
    width: calc(37.4 * var(--s));
  }

  .polaroid-footer--mobile .polaroid-actions svg {
    height: calc(27.5 * var(--s));
    width: calc(27.5 * var(--s));
  }

  .polaroid-actions svg:hover {
    opacity: 1;
  }

  .polaroid-like {
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: inline-flex;
    padding: 0;
    position: relative;
  }

  .polaroid-like:focus-visible {
    border-radius: 4px;
    outline: 2px solid #111;
    outline-offset: 4px;
  }

  .polaroid-like[aria-pressed="true"] .polaroid-like-outline {
    opacity: 0;
  }

  /* The heart fills ~22% of the 1080px Lottie canvas, slightly up-right of centre;
     381% matches the outline icon's width and the 0.66% nudges re-centre it. */
  .polaroid-like-anim {
    aspect-ratio: 1;
    left: 50%;
    pointer-events: none;
    position: absolute;
    top: 50%;
    transform: translate(calc(-50% - 0.66%), calc(-50% + 0.66%));
    width: 440%;
  }

  .polaroid-like-anim :global(svg) {
    display: block;
  }

  @media (max-width: 600px) {
    .polaroid-wrap {
      height: var(--polaroid-height, 678px);
      width: var(--polaroid-width, 482px);
    }

    .polaroid-frame--desktop {
      display: none;
    }

    .polaroid-frame--mobile {
      display: block;
      height: 100%;
      inset: auto;
      position: relative;
      width: 100%;
    }
  }
</style>
