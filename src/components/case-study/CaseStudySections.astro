---
import CaseStudyBodyBlock from "./CaseStudyBodyBlock.astro";
import type { CaseStudySection } from "../../lib/case-study-v2-types";

type Props = {
  sections: CaseStudySection[];
};

const { sections } = Astro.props;

/** Render inside the section title block with the section h2 (and intro). */
const LEAD_BLOCK_TYPES = new Set([
  "features",
  "mission",
  "researchGrid",
  "tabs",
  "solutionShowcase",
]);
---

{
  sections.map((section) => (
    <>
      <div class="case-study-sheet-anchor" id={section.id} aria-hidden="true" />
      <section
        class:list={[
          "case-study-section",
          section.blocks?.length ? "case-study-section--editorial" : "case-study-slide",
        ]}
        aria-labelledby={
          section.title
            ? `${section.id}-heading`
            : section.eyebrow
              ? `${section.id}-eyebrow`
              : `${section.id}-heading`
        }
        data-case-sheet
      >
        {section.blocks?.length ? (
          <>
            {section.eyebrow ? (
              <p
                class="case-study-section-eyebrow"
                id={section.title ? undefined : `${section.id}-eyebrow`}
              >
                {section.eyebrow}
              </p>
            ) : null}
            <div class="case-study-section-block">
              {section.title ? (
                <h2 class="case-study-section-heading" id={`${section.id}-heading`}>
                  {section.title}
                </h2>
              ) : null}
              {section.intro ? (
                <p class="case-study-section-intro">{section.intro}</p>
              ) : null}
              {section.blocks
                .filter((block) => LEAD_BLOCK_TYPES.has(block.type))
                .map((block) => (
                  <CaseStudyBodyBlock block={block} />
                ))}
            </div>

            {section.blocks
              .filter((block) => !LEAD_BLOCK_TYPES.has(block.type))
              .map((block) => (
                <CaseStudyBodyBlock block={block} />
              ))}
          </>
        ) : (
          <>
            {section.title ? (
              <h2 class="case-study-section-heading sr-only" id={`${section.id}-heading`}>
                {section.title}
              </h2>
            ) : null}
            <figure class="case-study-slide-figure">
              {(section.images ?? []).map((image) => (
                <img src={image.src} alt={image.alt} loading="lazy" />
              ))}
            </figure>
          </>
        )}
      </section>
    </>
  ))
}

<script>
  function initCaseStudySheets() {
    const sheets = Array.from(document.querySelectorAll<HTMLElement>("[data-case-sheet]"));
    if (!sheets.length) return;

    const w = window as Window & { _sheetsAbort?: AbortController; _sheetsResize?: ResizeObserver };
    w._sheetsAbort?.abort();
    w._sheetsResize?.disconnect();
    const ac = new AbortController();
    w._sheetsAbort = ac;
    const { signal } = ac;

    let ticking = false;

    const measure = () => {
      const vh = window.innerHeight;
      sheets.forEach((sheet) => {
        sheet.style.setProperty("--sheet-top", `${Math.min(0, vh - sheet.offsetHeight)}px`);
      });
      update();
    };

    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      sheets.forEach((sheet, i) => {
        const next = sheets[i + 1];
        if (!next) {
          sheet.style.setProperty("--sheet-cover", "0");
          return;
        }
        const rect = sheet.getBoundingClientRect();
        const visible = Math.min(rect.bottom, vh) - Math.max(rect.top, 0);
        const overlap = rect.bottom - next.getBoundingClientRect().top;
        const cover = visible > 0 ? Math.min(1, Math.max(0, overlap / visible)) : 1;
        sheet.style.setProperty("--sheet-cover", cover.toFixed(3));
      });
    };

    const queue = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    const resize = new ResizeObserver(measure);
    w._sheetsResize = resize;
    sheets.forEach((sheet) => resize.observe(sheet));

    window.addEventListener("scroll", queue, { passive: true, signal });
    window.addEventListener("resize", measure, { signal });
    measure();
  }

  initCaseStudySheets();
  document.addEventListener("astro:page-load", initCaseStudySheets);
</script>
