---
import CaseStudyBodyBlock from "./CaseStudyBodyBlock.astro";
import { groupBlocks } from "../../lib/case-study-blocks";
import type { CanonicalBlock, CaseStudySection } from "../../lib/case-study-v2-types";

type Props = {
  sections: CaseStudySection[];
};

const { sections } = Astro.props;

/** Consecutive captioned galleries share a 2-column row (e.g. 50% + --2). */
function withGalleryRows(blocks: CanonicalBlock[]) {
  const rows: Array<CanonicalBlock | CanonicalBlock[]> = [];

  for (const block of blocks) {
    const prev = rows.at(-1);
    if (
      block.type === "captionedGallery" &&
      Array.isArray(prev) &&
      prev[0]?.type === "captionedGallery"
    ) {
      prev.push(block);
      continue;
    }
    rows.push(block.type === "captionedGallery" ? [block] : block);
  }

  return rows.map((row) => (Array.isArray(row) && row.length === 1 ? row[0] : row));
}
---

{
  sections.map((section) => (
    <>
      <div class="case-study-sheet-anchor" id={section.id} aria-hidden="true" />
      <section
        class:list={[
          "case-study-section",
          section.blocks?.length ? "case-study-section--editorial" : "case-study-slide",
        ]}
        aria-labelledby={
          section.title
            ? `${section.id}-heading`
            : section.eyebrow
              ? `${section.id}-eyebrow`
              : `${section.id}-heading`
        }
        data-case-sheet
      >
        {section.blocks?.length ? (
          <>
            {section.eyebrow ? (
              <p
                class="case-study-section-eyebrow"
                id={section.title ? undefined : `${section.id}-eyebrow`}
              >
                {section.eyebrow}
              </p>
            ) : null}
            {groupBlocks(section.blocks, { heading: section.title, intro: section.intro }).map(
              (group) =>
                !group.isHead && !group.heading && !group.intro ? (
                  withGalleryRows(group.blocks).map((item) =>
                    Array.isArray(item) ? (
                      <div class="case-study-gallery case-study-gallery--2">
                        {item.map((block) => (
                          <CaseStudyBodyBlock block={block} />
                        ))}
                      </div>
                    ) : (
                      <CaseStudyBodyBlock block={item} />
                    ),
                  )
                ) : (
                  <div class="case-study-section-block">
                    {group.heading ? (
                      <h2
                        class="case-study-section-heading"
                        id={group.isHead ? `${section.id}-heading` : undefined}
                      >
                        {group.heading}
                      </h2>
                    ) : null}
                    {(Array.isArray(group.intro) ? group.intro : group.intro ? [group.intro] : []).map(
                      (paragraph) => (
                        <p class="case-study-section-intro">{paragraph}</p>
                      ),
                    )}
                    {withGalleryRows(group.blocks).map((item) =>
                      Array.isArray(item) ? (
                        <div class="case-study-gallery case-study-gallery--2">
                          {item.map((block) => (
                            <CaseStudyBodyBlock block={block} />
                          ))}
                        </div>
                      ) : (
                        <CaseStudyBodyBlock block={item} />
                      ),
                    )}
                  </div>
                ),
            )}
          </>
        ) : (
          <>
            {section.title ? (
              <h2 class="case-study-section-heading sr-only" id={`${section.id}-heading`}>
                {section.title}
              </h2>
            ) : null}
            <figure class="case-study-slide-figure">
              {(section.images ?? []).map((image) => (
                <img src={image.src} alt={image.alt} loading="lazy" />
              ))}
            </figure>
          </>
        )}
      </section>
    </>
  ))
}

<script>
  import { initStackedSheets, type StackedSheetsSettings } from "../../scripts/stacked-sheets";

  const CASE_STUDY_SHEETS: StackedSheetsSettings = {
    selector: "[data-case-sheet]",
    fadeTo: 0.01,
    fadeCurve: "smooth",
    topOffset: 0,
    holdDistance: "0px",
    minHoldTime: 0,
    minWidth: 0,
  };

  const initCaseStudySheets = () => initStackedSheets(CASE_STUDY_SHEETS);
  initCaseStudySheets();
  document.addEventListener("astro:page-load", initCaseStudySheets);
</script>
