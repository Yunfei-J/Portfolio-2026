---
import CaseStudyFeatures from "./CaseStudyFeatures.astro";
import CaseStudyMediaPanel from "./CaseStudyMediaPanel.astro";
import CaseStudyMetrics from "./CaseStudyMetrics.astro";
import CaseStudyResearchGrid from "./CaseStudyResearchGrid.astro";
import CaseStudySolutionShowcase from "./CaseStudySolutionShowcase.astro";
import CaseStudyStatement from "./CaseStudyStatement.astro";
import CaseStudyTabs from "./CaseStudyTabs.astro";
import CaseStudyTimeline from "./CaseStudyTimeline.astro";
import type { CanonicalBlock } from "../../lib/case-study-v2-types";

type Props = {
  block: CanonicalBlock;
};

const { block } = Astro.props;
---

{block.type === "countCards" && <CaseStudyFeatures block={block} />}

{block.type === "statement" && <CaseStudyStatement block={block} />}

{(block.type === "metricPillars" || block.type === "metricList") && (
  <CaseStudyMetrics block={block} />
)}

{block.type === "mediaCarousel" && <CaseStudyResearchGrid block={block} />}

{block.type === "tabbedMedia" && <CaseStudyTabs block={block} />}

{block.type === "timeline" && <CaseStudyTimeline block={block} />}

{block.type === "copyMediaRows" && <CaseStudySolutionShowcase block={block} />}

{
  block.type === "tileGrid" && (
    <CaseStudyMediaPanel panel={{ layout: "quad", tiles: block.tiles }} />
  )
}

{
  block.type === "metricCards" && (
    <CaseStudyMediaPanel panel={{ layout: "metrics", note: block.note, cards: block.cards }} />
  )
}

{
  block.type === "prose" && block.paragraphs.length ? (
    <div class="case-study-copy">
      {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  ) : null
}

{
  block.type === "callout" && block.variant === "inline" && (
    <p class="case-study-callout-inline">
      <span class="case-study-callout-inline-chunk">{block.preamble}</span>
      {
        block.highlights.map((word, index) => (
          <>
            {index > 0 ? (
              <span class="case-study-callout-inline-chunk">
                {index === block.highlights.length - 1 ? ", & " : ", "}
              </span>
            ) : null}
            <span class="case-study-callout-inline-highlight">{word}</span>
          </>
        ))
      }
      <span class="case-study-callout-inline-chunk">.</span>
    </p>
  )
}

{
  block.type === "callout" && block.variant !== "inline" && (
    <aside class="case-study-callout">
      {block.label ? <p class="case-study-callout-label">{block.label}</p> : null}
      <p>{block.text}</p>
    </aside>
  )
}

{
  block.type === "statRow" && (
    <dl class="case-study-stats" style={`--columns: ${block.items.length};`}>
      {block.items.map((item) => (
        <div class="case-study-stat">
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
  )
}

{
  block.type === "arrowList" && (
    <div class="case-study-bullets">
      <ul>
        {block.items.map((item) => (
          <li>
            <span class="case-study-bullets-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-arrow-up-right preview-icon"
              >
                <path d="M7 7h10v10"></path>
                <path d="M7 17 17 7"></path>
              </svg>
            </span>
            <span class="case-study-bullets-text">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  block.type === "figure" &&
    (block.caption ? (
      <figure class="case-study-body-figure">
        <img src={block.image.src} alt={block.image.alt} loading="lazy" />
        <figcaption>{block.caption}</figcaption>
      </figure>
    ) : (
      <img
        class="case-study-body-image"
        src={block.image.src}
        alt={block.image.alt}
        loading="lazy"
      />
    ))
}

{
  block.type === "captionedGallery" && (
    <div
      class:list={[
        "case-study-gallery",
        block.columns && `case-study-gallery--${block.columns}`,
        block.surface === "paper" && "case-study-gallery--paper",
      ]}
    >
      {block.images.map((image) =>
        image.caption ? (
          <figure class="case-study-gallery-captioned">
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              style={
                block.imageRadius
                  ? `border-radius: var(--radius-${block.imageRadius})`
                  : undefined
              }
            />
            <figcaption>
              <span>{image.caption}</span>
              {image.subcaption ? <span>{image.subcaption}</span> : null}
            </figcaption>
          </figure>
        ) : (
          <figure>
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              style={
                block.imageRadius
                  ? `border-radius: var(--radius-${block.imageRadius})`
                  : undefined
              }
            />
          </figure>
        ),
      )}
    </div>
  )
}
