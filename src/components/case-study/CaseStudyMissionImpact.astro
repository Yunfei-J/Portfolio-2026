---
import type { CaseStudyBodyBlock } from "../../lib/case-study-v2-types";

type MissionImpactBlock = Extract<CaseStudyBodyBlock, { type: "mission" | "impact" }>;

type Props = {
  block: MissionImpactBlock;
};

const { block } = Astro.props;
---

{
  block.type === "mission" && (
    <div class="case-study-mission">
      <h2 class="case-study-mission-label">
        {block.heading}
        <img
          src="/assets/case-study-ui/mission-grip-icon.svg"
          width="21"
          height="34"
          alt=""
        />
      </h2>
      <p class="case-study-mission-statement">{block.statement}</p>
    </div>
  )
}

{
  block.type === "impact" && (
    <div class="case-study-section-block">
      <h2 class="case-study-section-heading">{block.heading ?? "Impact"}</h2>
      <div class="case-study-mission-pillars">
        {block.pillars.map((pillar) => (
          <article class="case-study-mission-pillar">
            <h3 class="case-study-mission-pillar-title">{pillar.title}</h3>
            <div class="case-study-mission-diamonds" aria-hidden="true">
              <img src="/assets/case-study-ui/impact-diamond.svg" width="10" height="15" alt="" />
              <img src="/assets/case-study-ui/impact-diamond.svg" width="10" height="15" alt="" />
              <img src="/assets/case-study-ui/impact-diamond.svg" width="10" height="15" alt="" />
            </div>
            <dl class="case-study-mission-metrics">
              {pillar.metrics.map((metric) => (
                <div class="case-study-mission-metric">
                  <dt>{metric.label}</dt>
                  <dd>{metric.value}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </div>
  )
}
