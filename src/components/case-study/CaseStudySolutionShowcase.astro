---
import CaseStudyMediaPanel from "./CaseStudyMediaPanel.astro";
import type { CopyMediaRowsBlock } from "../../lib/case-study-v2-types";

type Props = {
  block: CopyMediaRowsBlock;
};

const { block } = Astro.props;
---

<div class="case-study-solution-showcase">
  {
    block.groups.map((group) => (
      <section class="case-study-solution-group">
        {group.mediaHeading ? (
          <div class="case-study-solution-row case-study-solution-columns-head">
            <h2 class="case-study-solution-group-heading">{group.mediaHeading}</h2>
            <h2 class="case-study-solution-group-heading">{group.heading}</h2>
          </div>
        ) : (
          <h2 class="case-study-solution-group-heading">{group.heading}</h2>
        )}
        {
          group.rows.map((row) => (
            <article class="case-study-solution-row">
              <div class="case-study-solution-copy">
                <h3 class="case-study-solution-row-title">{row.title}</h3>
                <p class="case-study-solution-row-desc">{row.description}</p>
              </div>
              <CaseStudyMediaPanel panel={row.panel} />
            </article>
          ))
        }
      </section>
    ))
  }
</div>
